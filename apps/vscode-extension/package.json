{
  "name": "revcloud-blueprint",
  "displayName": "Revcloud Blueprint",
  "icon": "images/logo.png",
  "description": "Comprehensive testing framework for Salesforce Revenue Cloud - Pricing Module",
  "version": "1.3.4",
  "publisher": "forceweaver",
  "license": "EULA",
  "author": {
    "name": "forceweaver",
    "email": "arohitu@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arohitu/revcloud-blueprint-extension.git"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/arohitu"
  },
  "bugs": {
    "url": "https://form.jotform.com/252443148591055"
  },
  "homepage": "https://sfapp.forceweaver.com/",
  "engines": {
    "vscode": "^1.74.0"
  },
  "qna": false,
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "salesforce",
    "revenue cloud",
    "pricing",
    "configurator",
    "billing",
    "order management",
    "testing",
    "automation",
    "regression",
    "rca"
  ],
  "activationEvents": [
    "onView:revCloudBlueprint"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "revCloudBlueprintContainer",
          "title": "REVCLOUD BLUEPRINT",
          "icon": "images/rcb_logo_mono.svg"
        }
      ]
    },
    "views": {
      "revCloudBlueprintContainer": [
        {
          "id": "revCloudBlueprint",
          "name": "Home",
          "when": "!revCloudBlueprint.showUserStatus"
        },
        {
          "id": "revCloudBlueprint.userStatusView",
          "name": "User Status",
          "type": "webview",
          "when": "revCloudBlueprint.showUserStatus"
        }
      ]
    },
    "commands": [
      {
        "command": "revCloudBlueprint.createPricingSnapshot",
        "title": "Create New Pricing Snapshot",
        "icon": "$(add)"
      },
      {
        "command": "revCloudBlueprint.runPricingTest",
        "title": "Run Pricing Test",
        "icon": "$(play)"
      },
      {
        "command": "revCloudBlueprint.refreshTests",
        "title": "Refresh Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "revCloudBlueprint.deletePricingSnapshot",
        "title": "Delete Pricing Snapshot",
        "icon": "$(trash)"
      },
      {
        "command": "revCloudBlueprint.viewPricingDetails",
        "title": "View Pricing Details",
        "icon": "$(eye)"
      },
      {
        "command": "revCloudBlueprint.openSettings",
        "title": "Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "revCloudBlueprint.validateSchema",
        "title": "Validate Schema",
        "icon": "$(search)"
      },
      {
        "command": "revCloudBlueprint.createGroup",
        "title": "Create Group",
        "icon": "$(folder)"
      },
      {
        "command": "revCloudBlueprint.createGroupFromTitle",
        "title": "Create New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "revCloudBlueprint.deleteGroup",
        "title": "Delete Group",
        "icon": "$(trash)"
      },
      {
        "command": "revCloudBlueprint.addToGroup",
        "title": "Add to Group",
        "icon": "$(add)"
      },
      {
        "command": "revCloudBlueprint.removeFromGroup",
        "title": "Remove from Group",
        "icon": "$(remove)"
      },
      {
        "command": "revCloudBlueprint.runBatchTest",
        "title": "Run Batch Test",
        "icon": "$(play)"
      },
      {
        "command": "revCloudBlueprint.runTest",
        "title": "Run Test",
        "icon": "$(play)"
      },
      {
        "command": "revCloudBlueprint.createSnapshotInGroup",
        "title": "Create Snapshot in Group",
        "icon": "$(add)"
      },
      {
        "command": "revCloudBlueprint.changeGroup",
        "title": "Change Group",
        "icon": "$(folder)"
      },
      {
        "command": "revCloudBlueprint.viewSnapshot",
        "title": "View JSON",
        "icon": "$(file-code)"
      },
      {
        "command": "revCloudBlueprint.deleteSnapshot",
        "title": "Delete Snapshot",
        "icon": "$(trash)"
      },
      {
        "command": "revCloudBlueprint.setup",
        "title": "Setup Configuration",
        "icon": "$(tools)"
      },
      {
        "command": "revCloudBlueprint.toggleUserStatus",
        "title": "Show Account & License Info",
        "icon": "$(account)"
      },
      {
        "command": "revCloudBlueprint.refreshSnapshot",
        "title": "Refresh Snapshot",
        "icon": "$(sync)"
      },
      {
        "command": "revCloudBlueprint.showWelcome",
        "title": "Show Welcome Screen",
        "icon": "$(wand)"
      },
      {
        "command": "revCloudBlueprint.visualizeSnapshot",
        "title": "Visualize Snapshot",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "revCloudBlueprint.createPricingSnapshot",
          "when": "view == revCloudBlueprint",
          "group": "navigation@1"
        },
        {
          "command": "revCloudBlueprint.createGroupFromTitle",
          "when": "view == revCloudBlueprint",
          "group": "navigation@2"
        },
        {
          "command": "revCloudBlueprint.refreshTests",
          "when": "view == revCloudBlueprint",
          "group": "navigation@3"
        },
        {
          "command": "revCloudBlueprint.openSettings",
          "when": "view == revCloudBlueprint",
          "group": "navigation@4"
        },
        {
          "command": "revCloudBlueprint.validateSchema",
          "when": "view == revCloudBlueprint",
          "group": "navigation@5"
        },
        {
          "command": "revCloudBlueprint.setup",
          "when": "view == revCloudBlueprint && revCloudBlueprint.setupRequired",
          "group": "navigation@0"
        },
        {
          "command": "revCloudBlueprint.showWelcome",
          "when": "view == revCloudBlueprint",
          "group": "navigation@6"
        },
        {
          "command": "revCloudBlueprint.toggleUserStatus",
          "when": "view == revCloudBlueprint",
          "group": "navigation@7"
        }
      ],
      "view/item/context": [
        {
          "command": "revCloudBlueprint.runPricingTest",
          "when": "view == revCloudBlueprint && viewItem == pricingSnapshot",
          "group": "inline@1"
        },
        {
          "command": "revCloudBlueprint.viewPricingDetails",
          "when": "view == revCloudBlueprint && viewItem == pricingSnapshot",
          "group": "inline@2"
        },
        {
          "command": "revCloudBlueprint.deletePricingSnapshot",
          "when": "view == revCloudBlueprint && viewItem == pricingSnapshot",
          "group": "inline@3"
        },
        {
          "command": "revCloudBlueprint.runBatchTest",
          "when": "view == revCloudBlueprint && viewItem == group",
          "group": "inline@1"
        },
        {
          "command": "revCloudBlueprint.createSnapshotInGroup",
          "when": "view == revCloudBlueprint && viewItem == group",
          "group": "inline@2"
        },
        {
          "command": "revCloudBlueprint.deleteGroup",
          "when": "view == revCloudBlueprint && viewItem == group",
          "group": "inline@3"
        },
        {
          "command": "revCloudBlueprint.runTest",
          "when": "view == revCloudBlueprint && viewItem == snapshot",
          "group": "inline@1"
        },
        {
          "command": "revCloudBlueprint.changeGroup",
          "when": "view == revCloudBlueprint && viewItem == snapshot",
          "group": "inline@2"
        },
        {
          "command": "revCloudBlueprint.viewSnapshot",
          "when": "view == revCloudBlueprint && viewItem == snapshot",
          "group": "inline@3"
        },
        {
          "command": "revCloudBlueprint.visualizeSnapshot",
          "when": "view == revCloudBlueprint && viewItem == snapshot",
          "group": "inline@4"
        },
        {
          "command": "revCloudBlueprint.refreshSnapshot",
          "when": "view == revCloudBlueprint && viewItem == snapshot",
          "group": "inline@5"
        },
        {
          "command": "revCloudBlueprint.deleteSnapshot",
          "when": "view == revCloudBlueprint && viewItem == snapshot",
          "group": "inline@6"
        }
      ]
    },
    "configuration": {
      "title": "Revcloud Blueprint",
      "properties": {
        "revCloudBlueprint.pricing.snapshotDirectory": {
          "type": "string",
          "default": "revcloud_blueprint/pricing/snapshots",
          "description": "Directory path where snapshot files will be stored (relative to workspace root)"
        },
        "revCloudBlueprint.pricing.productExternalIdField": {
          "type": "string",
          "default": "ProductCode",
          "description": "API name of the Product external ID field used for cross-org matching"
        },
        "revCloudBlueprint.salesforce.apiVersion": {
          "type": "string",
          "default": "",
          "description": "Salesforce API version to use (e.g., 'v64.0', 'v62.0'). Leave empty to use default v64.0",
          "pattern": "^(v\\d{2}\\.0)?$",
          "patternErrorMessage": "API version must be in format 'v64.0' or empty for default"
        },
        "revCloudBlueprint.pricing.attributeDefinitionExternalIdField": {
          "type": "string",
          "default": "Code",
          "description": "External ID field name on AttributeDefinition object for cross-org matching (e.g., 'Code', 'Name')",
          "examples": [
            "Code",
            "Name",
            "ExternalId__c"
          ]
        },
        "revCloudBlueprint.pricing.pricingPollingInitialDelayMs": {
          "type": "number",
          "default": 10000,
          "minimum": 5000,
          "maximum": 15000,
          "description": "Delay in milliseconds after quote creation to allow pricing data to be committed to database before fetching results"
        },
        "revCloudBlueprint.pricing.attributePicklistValueExternalIdField": {
          "type": "string",
          "default": "Code",
          "description": "External ID field name on AttributePicklistValue object for cross-org matching (e.g., 'Code', 'Name')",
          "examples": [
            "Code",
            "Name",
            "ExternalId__c"
          ]
        },
        "revCloudBlueprint.defaultSourceOrg": {
          "type": "string",
          "default": "",
          "description": "Default source org alias for creating snapshots"
        },
        "revCloudBlueprint.defaultTargetOrg": {
          "type": "string",
          "default": "",
          "description": "Default target org alias for running tests"
        },
        "revCloudBlueprint.autoRefreshTests": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh test list when files change"
        },
        "revCloudBlueprint.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging for debugging purposes"
        },
        "revCloudBlueprint.hideSetupMessage": {
          "type": "boolean",
          "default": false,
          "description": "Hide the setup message on extension activation"
        },
        "revCloudBlueprint.comparison.treatNullAsZero": {
          "type": "boolean",
          "default": true,
          "description": "Treat null values as equivalent to 0, 0.0, or 0.00 when comparing numeric fields"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-ext",
    "compile": "tsc -p ./",
    "package-ext": "webpack --mode production --devtool hidden-source-map",
    "compile-dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "npm run compile && node ./out/test/runTest.js",
    "test:all": "npm test && npm run test:integration",
    "package": "vsce package",
    "publish": "vsce publish",
    "prepackage": "npm run compile && npm test",
    "debug": "npm run compile && code --extensionDevelopmentPath=. --disable-extensions",
    "install-local": "npm run package && code --install-extension *.vsix",
    "uninstall-local": "code --uninstall-extension rohit.revcloud-blueprint"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.19.0",
    "glob": "^8.1.0",
    "jest": "^29.7.0",
    "mocha": "^10.2.0",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "diff": "^5.1.0"
  },
  "extensionDependencies": [
    "salesforce.salesforcedx-vscode"
  ]
}
