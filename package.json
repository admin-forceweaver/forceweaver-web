{
  "name": "forceweaver-web",
  "version": "1.0.2",
  "private": true,
  "description": "ForceWeaver marketing site and blog",
  "workspaces": [
    "apps/*",
    "domains/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "install:all": "npm install --workspaces",
    "dev:web": "npm run dev --workspace=@apps/web",
    "build:web": "npm run build --workspace=@apps/web",
    "import:wp-posts": "node scripts/import-wordpress-posts.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arohitu/forceweaver-web.git"
  },
  "author": {
    "name": "ForceWeaver",
    "email": "arohitu@gmail.com"
  },
  "license": "UNLICENSED"
}
