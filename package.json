{
  "name": "revcloud-blueprint",
  "version": "1.3.1",
  "private": true,
  "description": "Rev Cloud Blueprint - VS Code Extension and supporting packages",
  "workspaces": [
    "apps/*",
    "domains/*",
    "packages/*"
  ],
  "scripts": {
    "build:extension": "npm run package-ext --workspace=revcloud-blueprint",
    "test": "npm test --workspace=revcloud-blueprint",
    "compile": "npm run compile --workspace=revcloud-blueprint",
    "package": "npm run package --workspace=revcloud-blueprint",
    "test:all": "npm run test:all --workspace=revcloud-blueprint",
    "clean": "npm run clean --workspaces --if-present",
    "install:all": "npm install --workspaces",
    "dev:web": "npm run dev --workspace=@apps/web",
    "build:web": "npm run build --workspace=@apps/web"
  },
  "devDependencies": {
    "@types/node": "^18.15.0",
    "@types/jest": "^29.5.0",
    "@types/diff": "^5.0.0",
    "typescript": "^4.9.4",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "@types/mocha": "^10.0.1",
    "@types/glob": "^8.1.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "ts-loader": "^9.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arohitu/revcloud-blueprint-extension.git"
  },
  "author": {
    "name": "forceweaver",
    "email": "arohitu@gmail.com"
  },
  "license": "EULA"
}
